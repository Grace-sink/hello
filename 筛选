#在满足条件1和2的所有结构中找到能实现所需要的单元结构
#定义所需要的单元结构个数来实现0到2pi的位相梯度
No_str = 3
phase_interval = 2 * np.pi / (No_str-1) 

Phase_x_metalens = []
Phase_y_metalens = []
Transmittance_x_metalens = []
Transmittance_y_metalens = []
L_metalens = []
W_metalens = []
for k in range(No_str):
    #找到数组Transmittance_x中最接近T_min的元素的索引
    absolute_diff = np.abs(np.array(Phase_x_selected) - k * phase_interval)  # 计算每个元素与phi_x的绝对差，np.array将列表变换成数组类型才能与后面数相减
    closest_index = np.argmin(absolute_diff)  # 找到最小差值的索引
    L_metalens.append(L_selected[closest_index])
    W_metalens.append(W_selected[closest_index])
    Phase_x_metalens.append(np.array(Phase_x_selected[closest_index]))
    Phase_y_metalens.append(np.array(Phase_y_selected[closest_index]))
    Transmittance_x_metalens.append(np.array(Transmittance_x_selected[closest_index]))
    Transmittance_y_metalens.append(np.array(Transmittance_y_selected[closest_index]))
