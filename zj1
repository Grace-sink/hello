clear;
selectall;
delete;
nm=1e-9;#纳米单位
um=1e-6;#微米单位

#设置基底的高度和周期
h_BaF2=1.5*um;
p_BaF2=4.5*um;

#添加矩形柱
addrect;
set("name","BaF2");#名称
set("index",1.396); #设置折射率 
set("x",0);#设置x中心点坐标 
set("y",0);#设置y中心点坐标
set("z",0);#设置z中心点坐标，基底中心坐标为坐标原点
set("x span",p_BaF2);#设置x方向宽度
set("y span",p_BaF2);#设置y方向宽度
set("z span",h_BaF2);#设置z方向宽度

#设置上层矩形的高度，宽度和长度
h_Si=8*um;
w_Si=600*nm;
l_Si=600*nm;
addrect;
set("name","Si");
set("index",3.48); #设置折射率
set("x",0);
set("y",0*um);
set("x span",l_Si);#设置x方向宽度
set("y span",w_Si);#设置y方向宽度
set("z",h_BaF2/2+h_Si/2);#矩形中心坐标为基底坐标一半+圆柱坐标一半
set("z span",h_Si);
#要使用PB相位所以结构设置时要加入旋转角度
setnamed("Si","first axis","z");#设置旋转轴
setnamed("Si","rotation 1",0);#设置旋转角度

#添加x偏振光
size_plane=p_BaF2;
z_plane=-0.75*um;
addplane;
set("name","sources_x");
set("injection axis","z");#入射轴与z轴平行
set("direction","forward");#朝向z正方向入射
set("x",0);
set("x span",size_plane);
set("y",0);
set("y span",size_plane);
set("z",z_plane);
set("wavelength start",8*um);#波长（最小）
set("wavelength stop",8*um);#波长（最大）
set("amplitude",1);#振幅，默认为1，无特殊需要可不设置
set("phase",0);#初始相位，角度制，默认为0，无特殊需要可不设置
set("angle theta",0);#入射角theta
set("angle phi",0);#入射角phi
set("polarization angle",0);#偏振角

#设置仿真区域的最小z值，pml层距离结构至少要半个最大波长
z_min_fdtd=-1*um;
z_max_fdtd=9*um;
x_span_fdtd=p_BaF2;
#添加FDTD仿真区域
addfdtd;
set("dimension",2);#仿真区域为三维区域
set("x",0);
set("x span",x_span_fdtd);
set("y",0);
set("y span",x_span_fdtd);
set("z min",z_min_fdtd);
set("z max",z_max_fdtd);
set("x min bc","periodic");#设置x方向周期边界条件
set("y min bc","periodic");#设置y方向周期边界条件
set("Mesh type","auto non-uniform");#仿真网格为自定义方式
set("Mesh accuracy",6);
addprofile;
set("name","T");
set("monitor type","2D Z-normal");
set("x",0);
set("x span",p_BaF2);
set("y",0);
set("y span",p_BaF2);
set("z",8.75*um);
set("override global monitor settings",1);
set("frequency points",1);

#添加点监视器,监视透射光的电场
addprofile;
set("name","R");
set("monitor type","point");
set("x",0);
set("y",0);
set("z",8.75*um);
set("override global monitor settings",1);
set("frequency points",1);

#添加时间监视器
addtime;
set("name","time");
run;#运行仿真


E=getresult("R","E");#获取点监视器的E
Ex = pinch(E.Ex); # 提取Ex分量并降维

phi_x = angle(Ex); # 计算Ex的相位（弧度）
phi_x = unwrap(phi_x); # 相位解卷绕，消除2π跳变
phi_x = phi_x * 180 / pi; # 转化为角度

lambda = E.lambda; # 获取波长数据
plot(lambda, phi_x, "wavelength(um)", "Phase(°)", "x偏振相位", "linewidth=2");

#添加嵌套扫描，扫描单元结构长度的同时扫描宽度，得到不同长宽下的相位数据
addsweep;
setsweep("sweep", "name", "width");
setsweep("width", "type", "Ranges");
nosweep = 80; #扫描的点数
setsweep("width", "number of points", nosweep); 
para = struct;
para.Name = "width"; #扫描的宽1
para.Parameter = "::model::Si::y span";
para.Type = "Length"; 
para.Start = 600*nm; #起始
para.Stop = 4000*nm; # 终止
para.Units = "nm";
addsweepparameter("width", para);
result_1 = struct;
result_1.Name = "Ex";
result_1.Result = "::model::R::Ex";

result_2 = struct;
result_2.Name = "Ey";
result_2.Result = "::model::R::Ey";

result_3 = struct;
result_3.Name = "T";
result_3.Result = "::model::T::T";



addsweepresult("width", result_1);
addsweepresult("width", result_2);
addsweepresult("width", result_3);

insertsweep("width");

setsweep("sweep", "name", "length1");
setsweep("length1", "type", "Ranges");
nosweep = 80; #扫描的点数
setsweep("length1", "number of points", nosweep); 
para = struct;
para.Name = "length1"; #扫描的长
para.Parameter = "::model::Si::x span";
para.Type = "Length"; 
para.Start = 600*nm; #开始数值
para.Stop =4000*nm; # 截至数值
para.Units = "nm";
addsweepparameter("length1", para);

result_1 = struct;
result_1.Name = "Ex";
result_1.Result = "Ex";

result_2 = struct;
result_2.Name = "Ey";
result_2.Result = "Ey";

result_3 = struct;
result_3.Name = "T";
result_3.Result = "T";
addsweepresult("length1", result_1);
addsweepresult("length1", result_2);
addsweepresult("length1", result_3);

runsweep("length1");

#获取扫描得到的数据，画出相位随频率变化的图（应与前边波长相位随波长变化的图相反）
sname = "length1";
width1= getsweepdata(sname,"width");
length1= getsweepdata(sname,"length1");

Ex = getsweepdata(sname,"Ex");
Ey = getsweepdata(sname,"Ey");
T = getsweepdata(sname,"T");
n_wavelength = 1; #波长点数（起始波长和终止波长相同）
n_width1=80;
n_length1 =80;

lambda = 8*um; # 单一波长
f = c / lambda; # 计算频率


# 直接使用 Ex 分量（x 线偏振）
phi_x = angle(Ex); # 计算 x 偏振的相位

# 嵌套循环进行相位解卷绕
for(a = 1:n_width1) {
for(i = 1:n_length1) {
phi_x(a, i) = unwrap(phi_x(a, i));
}
}

# 获取 x 偏振的透射率（需要在监视器中预先设置）
T = getsweepdata(sname, "T");

#把Ex，Ey，相位，长度，宽度，波长，频率春到matlab文件里
matlabsave('all_data1', Ex, Ey, phi_x, width1, length1, lambda, f, T);




Matlab
clc;
clear all;
close all;
load all_data1.mat
figure;
imagesc(length1, width1, T);
set(gca,'YDir','normal');
colormap(jet);
colorbar;
caxis([0 1]); % 如果 Tx 是 0–1
xlabel('L (nm)');
ylabel('W (nm)');
title('T_x');
hold on;

clc;
clear all;
close all;
load all_data1.mat
figure;
imagesc(length1* 1e9, width1* 1e9, T);
set(gca,'YDir','normal');
axis image;
colormap(jet);
colorbar;
caxis([0 1]); % 如果 Tx 是 0–1
xlabel('L (nm)');
ylabel('W (nm)');
title('T_x');
hold on;

phi_norm=phi_x / (2*pi);
figure;
imagesc(length1* 1e9, width1* 1e9, phi_norm);
set(gca,'YDir','normal');
axis image;
colormap(jet);
colorbar;
caxis([-0.5 0.5]); % 根据你自己的数据调整
xlabel('L (nm)');
ylabel('W (nm)');
title('\phi_x / (2\pi)');
hold on;




